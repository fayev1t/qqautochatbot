# 应用运行配置
LOG_LEVEL=DEBUG
ENVIRONMENT=dev
DRIVER=~fastapi
ONEBOT_ACCESS_TOKEN=your_onebot_access_token
HOST=0.0.0.0
PORT=7500
SUPERUSERS=["123456789"]
NICKNAME=["小奏"]
COMMAND_START=["/", ""]
COMMAND_SEP=["."]
QQBOT_ENABLE_TEST_EVENTS=0

# 应用数据库：双机部署时，应用服务器直接访问 Docker 服务服务器上的 PostgreSQL
DATABASE_URL=postgresql+asyncpg://admin:your_postgres_password@your_docker_service_host:7504/mydb

# ── LLM 路由（**必配**；契约见 开发文档/v2.0/20-横切契约/LLM路由契约.md）──
# LLM 的一切参数都在 JSON 配置文件 config/model_providers.json（模板：
# config/model_providers.example.json；真实文件含各服务商 api_key，已被
# .gitignore 排除，勿提交）。**缺这个文件 = LLM 全线不可用**（启动日志里一条
# error；Planner 每拍降级 idle、图片不描述），没有回落。.env 里**没有任何
# LLM 键**：扁平的 LLM_PROVIDER / LLM_API_KEY / LLM_MODEL / LLM_BASE_URL
# 于 2026-07-28 删除，LLM_TEMPERATURE / LLM_MAX_TOKENS 于 2026-07-29 移入
# 下述 settings 段。文件三段：
#   providers  服务商注册表（name / base_url / api_key / 持有的 models；模型可带
#              capabilities:["vision"] 标签）
#   roles      用途 → 模型名，可钉死服务商、可配 per-role temperature：
#                planner            纯文本即可（2026-07-28 起不再收图，图片以
#                                   ingest 期转录出的 desc= 文本抵达）
#                vision             timeline 图片客观转录 + look_at_image 重看，
#                                   须带 vision 能力，建议多候选 + round_robin
#                                   + 低温 0.2
#                caption            表情包收藏描述，须带 vision 能力，建议低温 0.2
#                memory / default
#   settings   全局策略与冷却（缺省 strategy=random：调用只给模型名，在持有该
#              模型的服务商里随机选；planner 这类长前缀高频场景在意前缀缓存命中
#              率的话，可按 role 覆写为 primary_failover）+ 全局采样缺省
#              （temperature / max_tokens，role 与端点没配时的兜底）
# 配置文件路径可用下面的 env 覆写（默认 <项目根>/config/model_providers.json）：
# MODEL_PROVIDERS_PATH=./config/model_providers.json

# NapCat 重要配置（当前 docker/napcat/compose.yml 对照值）
NAPCAT_WEBUI_HOST_PORT=7501
NAPCAT_HTTP_HOST_PORT=7502
NAPCAT_WS_HOST_PORT=7503

# Postgres 重要配置（当前 docker/postgres/compose.yml 对照值）
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=mydb
POSTGRES_HOST_PORT=7504

# websearch 工具搜索后端：exa（默认，免 key，Exa 托管 MCP）或 tavily
WEBSEARCH_PROVIDER=exa
# 仅 WEBSEARCH_PROVIDER=tavily 时需要：https://app.tavily.com 注册获取
TAVILY_API_KEY=tvly-your-tavily-api-key

# Prompt 快照（可观测性基线，待办 #11）：每次 LLM 请求落一份完整快照
# （system prompt 分段统计 / user XML / 响应 / token 用量 / 耗时），
# 供排障与 prompt 改动回放对比。代码默认关闭；部署侧建议开启。
PROMPT_SNAPSHOT_ENABLED=true
PROMPT_SNAPSHOT_DIR=./runtime_data/prompt_snapshots
# 目录内快照文件总数上限，超限删最旧
PROMPT_SNAPSHOT_KEEP=200
# 允许落盘的 scope 前缀白名单（私聊默认不落盘）
PROMPT_SNAPSHOT_SCOPES=group,system

# ── 滚动记忆压缩（契约见 开发文档/v2.0/20-横切契约/记忆系统契约.md）──
# 把滚出条数窗的旧聊天折叠成每群一份的滚动摘要（runtime.context_compacted），
# 注入时间线头部。默认关闭；单群灰度验证后再开。
MEMORY_COMPACTION_ENABLED=false
# 灰度白名单：逗号分隔的 scope_key（group:123456）或裸群号；空 = 全部群。
# 压缩器构造时读定，改动需重启
MEMORY_COMPACTION_SCOPES=
# 摘要硬上限（字符，≈1k token 中文）
MEMORY_SUMMARY_MAX_CHARS=1200
# 游标后未覆盖事件数达到该值才触发一次 merge；启动/定时扫描不触发。
# 每次 merge 复用上一版落盘摘要，并保留最新 KEEP 条事件不折叠。
# 单批折叠上限 = (TRIGGER − KEEP) × 2（默认 200 条，代码常量派生、无独立
# 键）：积压超出的部分整段跳过、永不进摘要——记忆只覆盖"开始记之后"。
# 调参不变式见契约 §6（KEEP 须盖住可见窗口滞回峰值 130 行）
MEMORY_COMPACTION_TRIGGER_EVENTS=250
MEMORY_COMPACTION_KEEP_EVENTS=150

# ── 静默叫醒（契约见 开发文档/v2.0/20-横切契约/任务与决策契约.md §反思）──
# 群里彻底安静满该秒数后落一条 runtime.silence_elapsed 并开一拍，给"回想"
# 一个发生的时机（她只在有事发生时被叫醒，静默本身不产生事件）。一段静默
# 只响一次，有新动静才重新武装；计时器仅存进程内存，重启即丢。
# 只作用于 group scope。设为 0 或负数 = 关闭这条叫醒。
SILENCE_REFLECTION_SECONDS=600

# 自续拍上界（2026-08-04；2026-08-17 提案-裁决改了口径）。
# 提案拍、裁决报错拍、注册层拦下的非法行动、Runner 完成都会自续；每一次都走
# 同一条 3 秒攒批窗，没有「立刻再开一拍」的旁路。一次正常开口要吃掉 3 层深度
# （提案 → 裁决 → 执行完再决策），配 N 时按此估算。
# 留空 = 不限制；0 = 关闭自续拍，退回纯事件驱动；N > 0 = 一段活动内最多连续
# 自续 N 拍。计数只被外部唤醒（消息 / wait 到点 / 静默叫醒）清零。
#
# 这是**部署侧兜底**，不是主要机制：真在生产里自转起来时不改代码就能收。
# 挡住「错 → 回灌 → 再错」的是提示词纪律——`planner.md` 输出协议末段要求她
# 连着两条 <invalid_action> 就交空程序停下（空程序是唯一的停止符）。系统一侧不替
# 大模型数错误次数；她自己看得见时间线上有几条。
# 给 12 只是留个安全网：够走完 3~4 轮「提案→裁决→执行」，兜底不误伤正常自转。
AGENT_CONTINUATION_MAX_TICKS=12
